@model List<ContactInfo>

<h2>All Contacts</h2>
<hr/>
<a asp-action="AddContact" class="btn btn-primary mt-3">Add New Contact</a>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Company</th>
            <th>Email</th>
            <th>Mobile</th>
            <th></th>
        </tr>

    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ContactId</td>
                <td>@item.FirstName @item.LastName</td>
                <td>@item.CompanyName</td>
                <td>@item.EmailId</td>
                <td>@item.MobileNo</td>
                <td>
                    <a asp-action="GetContactById" asp-route-id="@item.ContactId" class=" mt-3">GetContactById</a>
                   
                </td>
            </tr>
        }
    </tbody>
</table>