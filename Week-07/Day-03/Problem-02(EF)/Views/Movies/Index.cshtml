@model IEnumerable<Movies>

<h1>Welcome to Index Page</h1>

<a asp-action="Create" class="btn btn-primary">Create New Movie</a>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Genre</th>
            <th>ReleaseDate</th>
            <th>Price</th>
            <th>Rating</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach(var movie in Model)
        {
            <tr>
                <td>@movie.Id</td>
                <td>@movie.Title</td>
                <td>@movie.Genre</td>
                <td>@movie.ReleaseDate</td>
                <td>@movie.Price</td>
                <td>@movie.Rating</td>

                <td>
                    <a asp-action="Details" asp-route-id="@movie.Id">Details</a>  |
                    <a asp-action="Edit" asp-route-id="@movie.Id">Edit</a>  |
                    <a asp-action="Delete" asp-route-id="@movie.Id">Delete</a> 
                </td>
            </tr>
        }
    </tbody>
</table>