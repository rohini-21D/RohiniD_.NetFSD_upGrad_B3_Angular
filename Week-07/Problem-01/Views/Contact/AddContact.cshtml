@model ContactInfo

<h1 class="text-center mb-4">Add Contact</h1>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <form method="post">

                <div class="mb-3">
                    <label class="form-label">Contact ID</label>
                    <input asp-for="ContactID" class="form-control" />
                    <span asp-validation-for="ContactID" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">First Name</label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Last Name</label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Company Name</label>
                    <input asp-for="CompanyName" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email ID</label>
                    <input asp-for="EmailId" class="form-control" />
                    <span asp-validation-for="EmailId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Mobile Number</label>
                    <input asp-for="MobileNo" class="form-control" />
                    <span asp-validation-for="MobileNo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Designation</label>
                    <input asp-for="Designation" class="form-control" />
                </div>

                <div>
                    <button type="submit" class="btn btn-primary px-4">Save</button>
                </div>

            </form>

            <a asp-action="ShowContacts" class="btn btn-primary mt-2">Back to Contacts</a>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}