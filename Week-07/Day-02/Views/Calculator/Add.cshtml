
<h2 class="text-center text-primary">Simple Calculator</h2>

<form asp-action="Add" asp-controller="Calculator" method="post">

    <div class="mb-3">
        <label>Number 1</label>
        <input type="number" name="num1" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Number 2</label>
        <input type="number" name="num2" class="form-control" />
    </div>

    <div class="text-center">
        <button type="submit" class="btn btn-success">Add</button>
    </div>

</form>

@if (ViewData["Result"] != null)
{
    <div class="mt-3 text-center">
        <h4 class="text-success">
            Result: @ViewData["Result"]
        </h4>
    </div>
}