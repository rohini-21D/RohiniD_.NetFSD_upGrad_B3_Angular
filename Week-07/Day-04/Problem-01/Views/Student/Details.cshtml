@model List<Course>

<h1>Full detsils</h1>

<table class="table">
    <tr>
        <th>CourseId</th>
        <th>CoureseName</th>
        <th>Students</th>
    </tr>

    @foreach(var item in Model)
    {
        <tr>
            <td>@item.CourseId</td>
            <td>@item.CourseName</td>
            <td>
                <ul>
                    @foreach(var std in item.Students)
                    {
                        <li>@std.StudName</li>
                    }
                </ul>
            </td>
        </tr>
    }

</table>