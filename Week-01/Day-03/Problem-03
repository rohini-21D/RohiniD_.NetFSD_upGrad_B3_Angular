<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Product Features</title>

<style>
/* Element selector */
body {
    font-family: "Segoe UI", Arial, sans-serif;
    background-color: #f4f6f8;
    margin: 0;
    padding: 0;
}

/* Class selector */
.features-section {
    text-align: center;
    padding: 40px;
}

/* Descendant selector */
.features-section h2 {
    color: #333;
    margin-bottom: 20px;
}

/* Styling the list */
.features-section ul {
    list-style-type: none;
    padding: 0;
    max-width: 500px;
    margin: auto;
}

/* Feature items */
.feature-item {
    background-color: #ffffff;
    color: #444;
    border: 2px solid #4CAF50;
    padding: 15px;
    margin: 10px 0;
    border-radius: 8px;
    transition: 0.3s;
}

/* Hover effect */
.feature-item:hover {
    background-color: #4CAF50;
    color: white;
    transform: scale(1.05);
}
</style>
</head>

<body>

<section class="features-section">
    <h2>Our Product Features</h2>

    <ul>
        <li class="feature-item">Fast Performance</li>
        <li class="feature-item">User Friendly Interface</li>
        <li class="feature-item">Secure Data Protection</li>
        <li class="feature-item">Cloud Backup Support</li>
        <li class="feature-item">24/7 Customer Support</li>
    </ul>
</section>

</body>
</html>
